# database configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/your_db_name

# Email configuration for sending emails (e.g., appointment confirmations, password resets)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=  your_smtp_password_here
FROM_EMAIL=your_email@example.com

# Cloudinary configuration for storing and managing images (e.g., profile pictures, medical reports)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here


GEMINI_API_KEY=gemini_api_key
PORT=port_no
MONGODB_URI=monogdb_uri
INDICTRANS_LOCAL_ENDPOINT=indictrans_endpoint
OPENAI_API_KEY=openai_api_key

NISARG_INTERVIEW_URL=nisarg_interview_url
DEVANG_ANALYZE_PRESCRIPTION_URL=devang_analyse_prescription_url
DEVANG_ANALYZE_LAB_URL=devang_analyse_lab_url

# ABDM Configuration
ABDM_WRAPPER_URL=http://localhost:8082
ABDM_HIU_ID=mock-hiu-id
ABDM_HIP_ID=mock-hip-id
